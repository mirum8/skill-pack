{{/IF_CLI}}### e2e scripts

Save reusable flows under `{{E2E_DIR}}/` and keep them. A good script asserts the whole result, not the easy half of it. Example shape:

    # {{E2E_DIR}}/test_widgets.sh
    set -u
    BIN="${TEST_APP_BIN:-{{BIN_PATH}}}"; T=$(mktemp -d)
    "$BIN" widgets add --name alpha > "$T/out" 2> "$T/err"; rc=$?
    [ "$rc" = 0 ]            || { echo "FAIL exit $rc"; cat "$T/err"; exit 1; }
    [ -s "$T/out" ]          || { echo "FAIL nothing on stdout"; exit 1; }
    [ -s "$T/err" ] && { echo "FAIL diagnostics leaked onto a clean run"; cat "$T/err"; exit 1; }
    echo "OK widgets add"

